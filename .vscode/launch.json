{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Astro dev",
      "type": "node",
      "request": "launch",
      "program": "${workspaceRoot}/node_modules/.bin/astro",
      "args": ["dev"],
      "runtimeArgs": ["--inspect-brk"],
      "console": "integratedTerminal"
    },
    {
      "name": "Astro build",
      "type": "node",
      "request": "launch",
      "program": "${workspaceRoot}/node_modules/.bin/astro",
      "args": ["build"],
      "runtimeArgs": ["--inspect-brk"],
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Browser debugging",
      "url": "http://localhost:4321",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
