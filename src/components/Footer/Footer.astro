---
import Container from '../Container/Container.astro';
import Link from '../Link/Link.astro';
import {ExternalLinks} from '../../utils';

const footerLinks = [
  {display: 'X', location: ExternalLinks.x()},
  {display: 'Github', location: ExternalLinks.github()},
];
---

<div class="border-t border-solid border-accent-line dark:border-accent-line-dark">
  <Container>
    <div class="flex flex-wrap py-medium">
      <div class="font-display font-bold text-text-bold dark:text-text-bold-dark">
        &copy; {new Date().getFullYear()} Trevor Harmon
      </div>
      <ul class="list-style-none p-0 m-0 ml-auto w-full md:w-auto">
        {
          footerLinks.map((link) => (
            <li class="inline-block ml-small first:ml-0">
              <Link url={link.location} target="_blank">
                {link.display}
              </Link>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</div>
