---
import Link from '../components/Link/Link.astro';
import Layout from '../layouts/Layout.astro';
import {Routes} from '../utils';
---

<Layout
  title="404"
  class="flex flex-col justify-center text-center text-text dark:text-text-dark"
>
  <h1 class="page text-[6rem] leading-[10rem] m-0 my-normal">
    <span>404</span>
  </h1>
  <p>Looks like you still haven't found what you're looking for.</p>
  <p class="mb-huge">
    <Link url={Routes.home()} icon={{name: 'arrowRight', position: 'trailing'}}>
      Go Home
    </Link>
  </p>
</Layout>
