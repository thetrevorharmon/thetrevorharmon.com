---
// E2E-only pages for the Playwright suite (theme tests, style comparison).
// They are only built when PARITY_TEST_PAGES=1, so they never ship:
//   PARITY_TEST_PAGES=1 yarn build
// Without the variable getStaticPaths returns nothing and no /e2e/ pages exist.
// Remove this directory once real pages (a post with an editor) can be used.
import BaseLayout from '../../layouts/BaseLayout.astro';
import {ThemePicker} from '../../components/Navbar/components/ThemePicker';
import {CodeEditor} from '../../components/CodeEditor';

export function getStaticPaths() {
  if (process.env.PARITY_TEST_PAGES !== '1') return [];
  return [
    {params: {page: 'theme-a'}},
    {params: {page: 'theme-b'}},
    {params: {page: 'style-test'}},
  ];
}

const {page} = Astro.params;
---

<BaseLayout title={`E2E ${page}`}>
  <div class="px-normal max-w-container mx-auto space-y-large mb-large">
    <div class="flex py-small">
      <a
        class="inline-block pt-[7px] pr-[9px] pb-[6px] pl-[10px] leading-none no-underline bg-body-bg dark:bg-body-bg-dark text-primary dark:text-primary-dark hover:text-white hover:bg-primary dark:hover:bg-primary-dark text-[1.6rem] md:text-[2rem] -tracking-[0.5px] md:-tracking-[1px] font-display font-bold uppercase border-2 border-stone-300 dark:border-stone-600 hover:border-primary rounded-lg transition-colors"
        href="/e2e/theme-a/">th.</a
      >
      <ul class="flex items-center list-style-none m-0 ml-auto p-0">
        <li class="ml-little md:ml-small first:ml-0">
          <a href="/e2e/theme-a/">Page A</a>
        </li>
        <li class="ml-little md:ml-small first:ml-0">
          <a href="/e2e/theme-b/">Page B</a>
        </li>
      </ul>
      <ThemePicker className="ml-small" client:load />
    </div>

    {
      page === 'style-test' ? (
        <div class="space-y-large my-huge">
          <h1 class="featured">About</h1>
          <div class="body-styles">
            <p>
              Hi there! Welcome to my little space on the internet. This page
              wound up being a little longer than expected, so here's a small
              table of contents for you:
            </p>
            <ol>
              <li><a href="#work">Work</a></li>
              <li><a href="#music">Music</a></li>
            </ol>
            <h2 id="work">Work</h2>
            <p>
              I graduated from <a href="https://www.byu.edu/" target="_blank" rel="nofollow noopener noreferrer">BYU</a> in 2018 and did a brief stunt at Pariveda, where I quickly learned that consulting was <em>not</em> for me. Working at Shopify has been both a delight and a wonderful learning opportunity–I have learned <em>so much</em> in my 6+ years here.
            </p>
            <h3 id="orders-reporting">Orders Reporting</h3>
            <p>
              As part of this project, we shipped new reports to merchants that made it a lot easier to understand their orders, including reporting around fulfillment and delivery times.
            </p>
            <h4>A fourth-level heading</h4>
            <ul>
              <li>One</li>
              <li>Two</li>
            </ul>
            <blockquote><p>A quote.</p></blockquote>
            <p class="Caption">A caption</p>
          </div>
        </div>
      ) : (
        <div class="space-y-large my-huge">
          <h1 class="featured">Theme test {page}</h1>
          <p id="marker">This is page {page}.</p>
          {page === 'theme-a' && (
            <CodeEditor client:load initialValue="const a = 1;" language="javascript" />
          )}
        </div>
      )
    }
  </div>
</BaseLayout>
